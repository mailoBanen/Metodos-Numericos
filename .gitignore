# --- Ignore Compiled Executables and Object Files ---
# These are generated by the compiler, not source code.
*.exe
*.out
*.o
a.out

# --- Ignore Program-Generated Output Files ---
# You probably don't need to version control the results your programs print.
output.txt
result.txt
*.log

# --- Ignore Editor and IDE Specific Files ---
# Visual Studio Code
.vscode/

# Vim
*.swp
*.swap

# --- Ignore Local System Files ---
.DS_Store
Thumbs.db

#Ignore PDFs
*.pdf




